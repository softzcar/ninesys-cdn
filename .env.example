# Secreto compartido con ninesys-api para validar su MISMO JWT de sesión de
# usuario (auditoría de seguridad 2026-09-10, cierra el hallazgo C6 -- ver
# [[project_fase_seguridad_pendiente]]). Debe ser EXACTAMENTE el mismo valor
# que JWT_SECRET en el .env de ninesys-api. Ver jwt_verify.php.
NINESYS_API_JWT_SECRET=

# Secreto de servicio compartido con ninesys-api y mcp_ninesys para permitir
# consultas de lectura (catalog, gallery_categories, list) desde servicios internos
# vía header X-Internal-Token sin sesión de usuario interactiva.
MSG_SERVICE_INTERNAL_TOKEN=

