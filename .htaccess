RewriteEngine on

# NOTA -- auditoría de seguridad 2026-09-15: las reglas RewriteRule de ESTE
# archivo (la raíz del docroot) NO tienen ningún efecto en este servidor --
# confirmado empíricamente (una regla de prueba trivial no hizo nada). El
# vhost tiene su propio bloque "rewrite{}" a nivel de servidor (vhost.conf,
# fuera de este repo) que shadowea el .htaccess de la raíz. Un .htaccess
# puesto DENTRO de un subdirectorio SÍ es honrado (confirmado con
# images/.htaccess y logs_gemini/.htaccess) -- por eso el bloqueo de
# logs_gemini/ vive en logs_gemini/.htaccess, no acá. error_log se eliminó
# del repo y su causa de recreación (un "Undefined index" evitable) se
# corrigió en index.php -- ver commit de esta misma fecha.

RewriteRule ^$ / [L]
RewriteRule (.*) /$1 [L]

# El CORS real vive en index.php (whitelist de orígenes) -- auditoría de
# seguridad 2026-09-15. La directiva "Header set ... *" que estuvo aquí
# antes no tenía ningún efecto real en este servidor (LiteSpeed no honra
# mod_headers vía .htaccess en este vhost, verificado empíricamente con
# curl contra un archivo estático) pero se retira igual por prolijidad,
# para no confundir a un futuro lector con una regla muerta que parece
# contradecir el whitelist de index.php.
